{
  "name": "@ag/memory",
  "version": "0.1.0",
  "private": true,
  "description": "Memory Store/Formation/Decay/Retrieval/Reinforcement/Consolidation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@ag/schemas": "workspace:*",
    "@ag/core": "workspace:*"
  }
}
