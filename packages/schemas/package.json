{
  "name": "@ag/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "数据契约单一事实来源（类型 + Zod + JSON Schema）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean && node scripts/generate-json-schema.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
