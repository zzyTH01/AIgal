{
  "type": "object",
  "properties": {
    "instanceId": {
      "type": "string",
      "minLength": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "day": {
      "type": "integer",
      "minimum": 0
    },
    "turn": {
      "type": "integer",
      "minimum": 0
    },
    "locationId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "resolved",
        "expired"
      ]
    },
    "createdAt": {
      "type": "object",
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 0
        },
        "time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      },
      "required": [
        "day",
        "time"
      ],
      "additionalProperties": false
    },
    "resolvedAt": {
      "type": "object",
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 0
        },
        "time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      },
      "required": [
        "day",
        "time"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "instanceId",
    "eventId",
    "runId",
    "day",
    "turn",
    "locationId",
    "title",
    "description",
    "status",
    "createdAt"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
