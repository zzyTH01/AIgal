              "encoding": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "retention": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "retrieval": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "forgetfulness": {
                "type": "number",
