            "type": "string",
            "enum": [
              "unknown",
              "stranger",
              "acquaintance",
              "friend",
              "close_friend",
              "romantic_interest",
              "partner",
              "family",
              "rival",
              "enemy",
              "estranged",
              "custom"
            ]
          }
        },
        "contentTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
