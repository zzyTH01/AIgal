          "requiresCharacterIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requiresRelationshipType": {
            "type": "string",
            "enum": [
              "unknown",
              "stranger",
              "acquaintance",
              "friend",
              "close_friend",
              "romantic_interest",
              "partner",
              "family",
              "rival",
              "enemy",
              "estranged",
              "custom"
            ]
          },
          "behaviorConstraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
