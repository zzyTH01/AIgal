                  "maximum": 100
                }
              },
              "independence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "sociability": {
                "type": "number",
