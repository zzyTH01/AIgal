                "maximum": 100
              },
              "assertiveness": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "empathy": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "openness": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
