        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "dailyProgressLimit": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "startDay": {
          "type": "integer",
          "minimum": 0
        },
        "startTime": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "startWeekday": {
          "type": "string",
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ]
        },
        "startSeason": {
          "type": "string",
          "enum": [
            "spring",
            "summer",
            "autumn",
            "winter"
          ]
