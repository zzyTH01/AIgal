{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "characterId": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "age": {
          "type": "integer",
          "minimum": 18
        },
        "gender": {
          "type": "string"
        },
        "genderIdentity": {
          "type": "string"
        },
        "sexualOrientation": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "age",
        "gender",
        "genderIdentity",
        "sexualOrientation",
        "role",
        "description"
      ],
      "additionalProperties": false
    },
    "personality": {
      "type": "object",
      "properties": {
        "traits": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "independence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sociability": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sensitivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "assertiveness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "empathy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "openness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "traits",
        "independence",
        "confidence",
        "sociability",
        "sensitivity",
        "assertiveness",
        "empathy",
        "openness"
      ],
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "properties": {
        "likes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dislikes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "likes",
        "dislikes",
        "interests"
      ],
      "additionalProperties": false
    },
    "speech": {
      "type": "object",
      "properties": {
        "style": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "style",
        "tone",
        "vocabulary",
        "examples"
      ],
      "additionalProperties": false
    },
    "psychologyDefaults": {
      "type": "object",
      "properties": {
        "dependence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "security": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "loneliness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "stress": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "jealousy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "selfWorth": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "emotionalStability": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "romanticTension": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "dependence",
        "security",
        "loneliness",
        "stress",
        "jealousy",
        "selfWorth",
        "emotionalStability",
        "romanticTension"
      ],
      "additionalProperties": false
    },
    "cognition": {
      "type": "object",
      "properties": {
        "memoryCapacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "encoding": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "retention": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "retrieval": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "forgetfulness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "grudge": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "obsession": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "attention": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "emotionalSalience": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "cognitiveLoad": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "memoryCapacity",
        "encoding",
        "retention",
        "retrieval",
        "forgetfulness",
        "grudge",
        "obsession",
        "attention",
        "emotionalSalience",
        "cognitiveLoad"
      ],
      "additionalProperties": false
    },
    "relationshipDefaults": {
      "type": "object",
      "properties": {
        "initialType": {
          "type": "string",
          "enum": [
            "unknown",
            "stranger",
            "acquaintance",
            "friend",
            "close_friend",
            "romantic_interest",
            "partner",
            "family",
            "rival",
            "enemy",
            "estranged",
            "custom"
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "initialType",
        "metrics",
        "tags"
      ],
      "additionalProperties": false
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          },
          "revealCondition": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "content",
          "revealCondition"
        ],
        "additionalProperties": false
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "description",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gameParameters": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "schemaVersion",
    "characterId",
    "identity",
    "personality",
    "preferences",
    "speech",
    "psychologyDefaults",
    "cognition",
    "relationshipDefaults",
    "secrets",
    "goals",
    "boundaries",
    "gameParameters"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
