{
  "name": "@ag/persistence",
  "version": "0.1.0",
  "private": true,
  "description": "Persistence\uff1aSave/Load/Export\uff08JSON\u2192SQLite\uff09",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./json-directory": {
      "types": "./dist/json-directory.d.ts",
      "import": "./dist/json-directory.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/json-directory.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "pretest": "pnpm --filter @ag/schemas build && pnpm --filter @ag/core build"
  },
  "dependencies": {
    "@ag/schemas": "workspace:*",
    "@ag/core": "workspace:*"
  }
}
