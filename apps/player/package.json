{
  "name": "@ag/player",
  "version": "0.1.0",
  "private": true,
  "description": "Play Mode 玩家 UI（React，Phase 9 实现）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "dev": "vite",
    "pretest": "pnpm --filter @ag/runtime test && pnpm --filter @ag/runtime build"
  },
  "dependencies": {
    "@ag/core": "workspace:*",
    "@ag/runtime": "workspace:*",
    "@ag/schemas": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^26.1.0",
    "vite": "^8.2.1"
  }
}
